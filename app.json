{
  "expo": {
    "name": "pazimo",
    "slug": "pazimo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pazimomobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080A",
    "ios": {
      "icon": "./assets/expo.icon",
      "userInterfaceStyle": "dark",
      "associatedDomains": [
        "applinks:pazimo.com"
      ],
      "bundleIdentifier": "com.kal-x.pazimomobile"
    },
    "android": {
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#08080A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kal_x.pazimomobile",
      "intentFilters": [
        {
          "autoVerify": true,
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "pazimo.com",
              "pathPrefix": "/events/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080A",
          "image": "./assets/images/pazimo-logo.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#08080A",
            "image": "./assets/images/pazimo-logo.png",
            "imageWidth": 220
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#08080A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
